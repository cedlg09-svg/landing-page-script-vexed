local InputService = game:GetService('UserInputService');
local TextService = game:GetService('TextService');
local CoreGui = game:GetService('CoreGui');
local Teams = game:GetService('Teams');
local Players = game:GetService('Players');
local RunService = game:GetService('RunService');
local TweenService = game:GetService('TweenService');
local RenderStepped = RunService.RenderStepped;
local LocalPlayer = Players.LocalPlayer;
local Mouse = LocalPlayer:GetMouse();

local ProtectGui = protectgui or (syn and syn.protect_gui) or (function() end);

local ScreenGui = Instance.new('ScreenGui');
ProtectGui(ScreenGui);

ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global;
ScreenGui.Parent = CoreGui;

local Toggles = {};
local Options = {};

getgenv().Toggles = Toggles;
getgenv().Options = Options;

local Library = {
    Registry = {};
    RegistryMap = {};
    HudRegistry = {};

    -- CloverHubUI Theme Palette
    FontColor = Color3.fromRGB(232, 232, 238);
    MainColor = Color3.fromRGB(18, 18, 21);
    BackgroundColor = Color3.fromRGB(11, 11, 13);
    SidebarColor = Color3.fromRGB(14, 14, 17);
    PanelAlt = Color3.fromRGB(22, 22, 26);
    AccentColor = Color3.fromRGB(150, 100, 245);
    AccentColorDark = Color3.fromRGB(110, 70, 190);
    OutlineColor = Color3.fromRGB(32, 32, 37);
    BorderSoft = Color3.fromRGB(26, 26, 30);
    RiskColor = Color3.fromRGB(232, 90, 90);
    GreenColor = Color3.fromRGB(64, 222, 137);

    Black = Color3.new(0, 0, 0);
    Font = Enum.Font.Gotham;
    FontMed = Enum.Font.GothamMedium;
    FontBold = Enum.Font.GothamBold;
    FontMono = Enum.Font.Code;

    OpenedFrames = {};
    DependencyBoxes = {};
    Signals = {};
    ScreenGui = ScreenGui;
};

local RainbowStep = 0
local Hue = 0

table.insert(Library.Signals, RenderStepped:Connect(function(Delta)
    RainbowStep = RainbowStep + Delta

    if RainbowStep >= (1 / 60) then
        RainbowStep = 0
        Hue = Hue + (1 / 400);

        if Hue > 1 then
            Hue = 0;
        end;

        Library.CurrentRainbowHue = Hue;
        Library.CurrentRainbowColor = Color3.fromHSV(Hue, 0.8, 1);
    end
end))

local function GetPlayersString()
    local PlayerList = Players:GetPlayers();
    for i = 1, #PlayerList do
        PlayerList[i] = PlayerList[i].Name;
    end;
    table.sort(PlayerList, function(str1, str2) return str1 < str2 end);
    return PlayerList;
end;

local function GetTeamsString()
    local TeamList = Teams:GetTeams();
    for i = 1, #TeamList do
        TeamList[i] = TeamList[i].Name;
    end;
    table.sort(TeamList, function(str1, str2) return str1 < str2 end);
    return TeamList;
end;

function Library:SafeCallback(f, ...)
    if (not f) then return; end;
    if not Library.NotifyOnError then
        return f(...);
    end;

    local success, event = pcall(f, ...);
    if not success then
        local _, i = event:find(":%d+: ");
        if not i then
            return Library:Notify(event);
        end;
        return Library:Notify(event:sub(i + 1), 3);
    end;
end;

function Library:AttemptSave()
    if Library.SaveManager then
        Library.SaveManager:Save();
    end;
end;

function Library:Create(Class, Properties)
    local _Instance = Class;
    if type(Class) == 'string' then
        _Instance = Instance.new(Class);
    end;

    local Children = Properties.Children or {}
    Properties.Children = nil

    for Property, Value in next, Properties do
        _Instance[Property] = Value;
    end;

    for _, Child in next, Children do
        Child.Parent = _Instance
    end

    return _Instance;
end;

function Library:ApplyCorner(Radius)
    return Library:Create('UICorner', {
        CornerRadius = Radius or UDim.new(0, 8);
    });
end

function Library:ApplyStroke(Color, Thickness)
    return Library:Create('UIStroke', {
        Color = Color or Library.OutlineColor;
        Thickness = Thickness or 1;
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border;
    });
end

function Library:CreateLabel(Properties, IsHud)
    local _Instance = Library:Create('TextLabel', {
        BackgroundTransparency = 1;
        Font = Library.Font;
        TextColor3 = Library.FontColor;
        TextSize = 13;
    });

    Library:AddToRegistry(_Instance, {
        TextColor3 = 'FontColor';
    }, IsHud);

    return Library:Create(_Instance, Properties);
end;

function Library:MakeDraggable(Instance, Cutoff)
    Instance.Active = true;
    Instance.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
            local ObjPos = Vector2.new(
                Mouse.X - Instance.AbsolutePosition.X,
                Mouse.Y - Instance.AbsolutePosition.Y
            );

            if ObjPos.Y > (Cutoff or 50) then
                return;
            end;

            while InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or InputService:IsMouseButtonPressed(Enum.UserInputType.Touch) do
                Instance.Position = UDim2.new(
                    0,
                    Mouse.X - ObjPos.X + (Instance.Size.X.Offset * Instance.AnchorPoint.X),
                    0,
                    Mouse.Y - ObjPos.Y + (Instance.Size.Y.Offset * Instance.AnchorPoint.Y)
                );
                RenderStepped:Wait();
            end;
        end;
    end)
end;

function Library:AddToolTip(InfoStr, HoverInstance)
    local X, Y = Library:GetTextBounds(InfoStr, Library.Font, 12);
    local Tooltip = Library:Create('Frame', {
        BackgroundColor3 = Library.MainColor,
        Size = UDim2.fromOffset(X + 8, Y + 6),
        ZIndex = 100,
        Parent = Library.ScreenGui,
        Visible = false,
        Children = {
            Library:ApplyCorner(UDim.new(0, 4)),
            Library:ApplyStroke(Library.OutlineColor)
        }
    })

    local Label = Library:CreateLabel({
        Position = UDim2.fromOffset(4, 2),
        Size = UDim2.fromOffset(X, Y);
        TextSize = 12;
        Text = InfoStr,
        TextColor3 = Library.FontColor,
        TextXAlignment = Enum.TextXAlignment.Left;
        ZIndex = Tooltip.ZIndex + 1,
        Parent = Tooltip;
    });

    Library:AddToRegistry(Tooltip, { BackgroundColor3 = 'MainColor' });
    Library:AddToRegistry(Label, { TextColor3 = 'FontColor' });

    local IsHovering = false

    HoverInstance.MouseEnter:Connect(function()
        if Library:MouseIsOverOpenedFrame() then return end
        IsHovering = true
        Tooltip.Position = UDim2.fromOffset(Mouse.X + 15, Mouse.Y + 12)
        Tooltip.Visible = true

        while IsHovering do
            RunService.Heartbeat:Wait()
            Tooltip.Position = UDim2.fromOffset(Mouse.X + 15, Mouse.Y + 12)
        end
    end)

    HoverInstance.MouseLeave:Connect(function()
        IsHovering = false
        Tooltip.Visible = false
    end)
end

function Library:OnHighlight(HighlightInstance, Instance, Properties, PropertiesDefault)
    HighlightInstance.MouseEnter:Connect(function()
        local Reg = Library.RegistryMap[Instance];
        for Property, ColorIdx in next, Properties do
            Instance[Property] = Library[ColorIdx] or ColorIdx;
            if Reg and Reg.Properties[Property] then
                Reg.Properties[Property] = ColorIdx;
            end;
        end;
    end)

    HighlightInstance.MouseLeave:Connect(function()
        local Reg = Library.RegistryMap[Instance];
        for Property, ColorIdx in next, PropertiesDefault do
            Instance[Property] = Library[ColorIdx] or ColorIdx;
            if Reg and Reg.Properties[Property] then
                Reg.Properties[Property] = ColorIdx;
            end;
        end;
    end)
end;

function Library:MouseIsOverOpenedFrame()
    for Frame, _ in next, Library.OpenedFrames do
        local AbsPos, AbsSize = Frame.AbsolutePosition, Frame.AbsoluteSize;
        if Mouse.X >= AbsPos.X and Mouse.X <= AbsPos.X + AbsSize.X
            and Mouse.Y >= AbsPos.Y and Mouse.Y <= AbsPos.Y + AbsSize.Y then
            return true;
        end;
    end;
end;

function Library:IsMouseOverFrame(Frame)
    local AbsPos, AbsSize = Frame.AbsolutePosition, Frame.AbsoluteSize;
    if Mouse.X >= AbsPos.X and Mouse.X <= AbsPos.X + AbsSize.X
        and Mouse.Y >= AbsPos.Y and Mouse.Y <= AbsPos.Y + AbsSize.Y then
        return true;
    end;
end;

function Library:UpdateDependencyBoxes()
    for _, Depbox in next, Library.DependencyBoxes do
        Depbox:Update();
    end;
end;

function Library:MapValue(Value, MinA, MaxA, MinB, MaxB)
    return (1 - ((Value - MinA) / (MaxA - MinA))) * MinB + ((Value - MinA) / (MaxA - MinA)) * MaxB;
end;

function Library:GetTextBounds(Text, Font, Size, Resolution)
    local Bounds = TextService:GetTextSize(Text, Size, Font, Resolution or Vector2.new(1920, 1080))
    return Bounds.X, Bounds.Y
end;

function Library:GetDarkerColor(Color)
    local H, S, V = Color3.toHSV(Color);
    return Color3.fromHSV(H, S, V / 1.5);
end;

function Library:AddToRegistry(Instance, Properties, IsHud)
    local Idx = #Library.Registry + 1;
    local Data = { Instance = Instance; Properties = Properties; Idx = Idx; };
    table.insert(Library.Registry, Data);
    Library.RegistryMap[Instance] = Data;

    if IsHud then
        table.insert(Library.HudRegistry, Data);
    end;
end;

function Library:RemoveFromRegistry(Instance)
    local Data = Library.RegistryMap[Instance];
    if Data then
        for Idx = #Library.Registry, 1, -1 do
            if Library.Registry[Idx] == Data then table.remove(Library.Registry, Idx); end;
        end;
        for Idx = #Library.HudRegistry, 1, -1 do
            if Library.HudRegistry[Idx] == Data then table.remove(Library.HudRegistry, Idx); end;
        end;
        Library.RegistryMap[Instance] = nil;
    end;
end;

function Library:UpdateColorsUsingRegistry()
    for _, Object in next, Library.Registry do
        for Property, ColorIdx in next, Object.Properties do
            if type(ColorIdx) == 'string' then
                Object.Instance[Property] = Library[ColorIdx];
            elseif type(ColorIdx) == 'function' then
                Object.Instance[Property] = ColorIdx()
            end
        end;
    end;
end;

function Library:GiveSignal(Signal)
    table.insert(Library.Signals, Signal)
end

function Library:Unload()
    for Idx = #Library.Signals, 1, -1 do
        local Connection = table.remove(Library.Signals, Idx)
        Connection:Disconnect()
    end
    if Library.OnUnload then Library.OnUnload() end
    ScreenGui:Destroy()
end

function Library:OnUnload(Callback)
    Library.OnUnload = Callback
end

Library:GiveSignal(ScreenGui.DescendantRemoving:Connect(function(Instance)
    if Library.RegistryMap[Instance] then
        Library:RemoveFromRegistry(Instance);
    end;
end))

local BaseAddons = {};

do
    local Funcs = {};

    function Funcs:AddColorPicker(Idx, Info)
        local ToggleLabel = self.TextLabel;
        assert(Info.Default, 'AddColorPicker: Missing default value.');

        local ColorPicker = {
            Value = Info.Default;
            Transparency = Info.Transparency or 0;
            Type = 'ColorPicker';
            Title = type(Info.Title) == 'string' and Info.Title or 'Color picker',
            Callback = Info.Callback or function(Color) end;
        };

        function ColorPicker:SetHSVFromRGB(Color)
            local H, S, V = Color3.toHSV(Color);
            ColorPicker.Hue = H;
            ColorPicker.Sat = S;
            ColorPicker.Vib = V;
        end;

        ColorPicker:SetHSVFromRGB(ColorPicker.Value);

        local DisplayFrame = Library:Create('Frame', {
            BackgroundColor3 = ColorPicker.Value;
            Size = UDim2.new(0, 24, 0, 14);
            ZIndex = 6;
            Parent = ToggleLabel;
            Children = {
                Library:ApplyCorner(UDim.new(0, 4)),
                Library:ApplyStroke(Library.BorderSoft)
            }
        });

        local PickerFrameOuter = Library:Create('Frame', {
            Name = 'Color';
            BackgroundColor3 = Library.BackgroundColor;
            Position = UDim2.fromOffset(DisplayFrame.AbsolutePosition.X, DisplayFrame.AbsolutePosition.Y + 18),
            Size = UDim2.fromOffset(220, Info.Transparency and 270 or 250);
            Visible = false;
            ZIndex = 15;
            Parent = ScreenGui,
            Children = {
                Library:ApplyCorner(UDim.new(0, 8)),
                Library:ApplyStroke(Library.OutlineColor)
            }
        });

        DisplayFrame:GetPropertyChangedSignal('AbsolutePosition'):Connect(function()
            PickerFrameOuter.Position = UDim2.fromOffset(DisplayFrame.AbsolutePosition.X, DisplayFrame.AbsolutePosition.Y + 18);
        end)

        local SatVibMapOuter = Library:Create('Frame', {
            BackgroundColor3 = Library.MainColor;
            Position = UDim2.new(0, 10, 0, 30);
            Size = UDim2.new(0, 150, 0, 150);
            ZIndex = 17;
            Parent = PickerFrameOuter;
            Children = {
                Library:ApplyCorner(UDim.new(0, 6)),
                Library:ApplyStroke(Library.BorderSoft)
            }
        });

        local SatVibMap = Library:Create('ImageLabel', {
            BackgroundTransparency = 1;
            Size = UDim2.new(1, 0, 1, 0);
            ZIndex = 18;
            Image = 'rbxassetid://4155801252';
            Parent = SatVibMapOuter;
            Children = {
                Library:ApplyCorner(UDim.new(0, 6))
            }
        });

        local CursorOuter = Library:Create('ImageLabel', {
            AnchorPoint = Vector2.new(0.5, 0.5);
            Size = UDim2.new(0, 6, 0, 6);
            BackgroundTransparency = 1;
            Image = 'rbxassetid://0';
            ZIndex = 19;
            Parent = SatVibMap;
        });

        local HueSelectorOuter = Library:Create('Frame', {
            BackgroundColor3 = Library.MainColor;
            Position = UDim2.new(0, 170, 0, 30);
            Size = UDim2.new(0, 15, 0, 150);
            ZIndex = 17;
            Parent = PickerFrameOuter;
            Children = {
                Library:ApplyCorner(UDim.new(0, 6)),
                Library:ApplyStroke(Library.BorderSoft)
            }
        });

        local HueSelectorInner = Library:Create('Frame', {
            BackgroundColor3 = Color3.new(1, 1, 1);
            BorderSizePixel = 0;
            Size = UDim2.new(1, 0, 1, 0);
            ZIndex = 18;
            Parent = HueSelectorOuter;
            Children = {
                Library:ApplyCorner(UDim.new(0, 6))
            }
        });

        local SequenceTable = {};
        for Hue = 0, 1, 0.1 do
            table.insert(SequenceTable, ColorSequenceKeypoint.new(Hue, Color3.fromHSV(Hue, 1, 1)));
        end;

        Library:Create('UIGradient', {
            Color = ColorSequence.new(SequenceTable);
            Rotation = 90;
            Parent = HueSelectorInner;
        });

        local HueCursor = Library:Create('Frame', { 
            BackgroundColor3 = Color3.new(1, 1, 1);
            AnchorPoint = Vector2.new(0, 0.5);
            Size = UDim2.new(1, 0, 0, 2);
            ZIndex = 19;
            Parent = HueSelectorInner;
        });

        Options[Idx] = ColorPicker;
        return self;
    end;

    function Funcs:AddKeyPicker(Idx, Info)
        local ParentObj = self;
        local ToggleLabel = self.TextLabel;
        
        local KeyPicker = {
            Value = Info.Default;
            Mode = Info.Mode or 'Toggle';
            Type = 'KeyPicker';
            Callback = Info.Callback or function(Value) end;
        };

        local PickOuter = Library:Create('TextButton', {
            BackgroundColor3 = Library.PanelAlt;
            Size = UDim2.new(0, 40, 0, 20);
            Position = UDim2.new(1, 0, 0.5, 0);
            AnchorPoint = Vector2.new(1, 0.5);
            Text = '';
            AutoButtonColor = false;
            Parent = ToggleLabel;
            Children = {
                Library:ApplyCorner(UDim.new(0, 4)),
                Library:ApplyStroke(Library.BorderSoft)
            }
        });

        local DisplayLabel = Library:CreateLabel({
            Size = UDim2.new(1, 0, 1, 0);
            TextSize = 11;
            Text = Info.Default;
            TextXAlignment = Enum.TextXAlignment.Center;
            Parent = PickOuter;
        });

        local Picking = false;

        PickOuter.Activated:Connect(function()
            if Picking then return end
            Picking = true
            DisplayLabel.Text = '...'
            
            local Event
            Event = InputService.InputBegan:Connect(function(Input)
                local Key
                if Input.UserInputType == Enum.UserInputType.Keyboard then
                    Key = Input.KeyCode.Name
                elseif Input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Key = 'MB1'
                elseif Input.UserInputType == Enum.UserInputType.MouseButton2 then
                    Key = 'MB2'
                end
                
                if Key then
                    DisplayLabel.Text = Key
                    KeyPicker.Value = Key
                    Picking = false
                    Event:Disconnect()
                    Library:SafeCallback(KeyPicker.Callback, Key)
                    Library:AttemptSave()
                end
            end)
        end)

        Options[Idx] = KeyPicker;
        return self;
    end;

    BaseAddons.__index = Funcs;
end;

local BaseGroupbox = {};

do
    local Funcs = {};

    function Funcs:AddBlank(Size)
        Library:Create('Frame', {
            BackgroundTransparency = 1;
            Size = UDim2.new(1, 0, 0, Size);
            Parent = self.Container;
        });
    end;

    function Funcs:AddLabel(Text, DoesWrap)
        local Label = {};
        local Groupbox = self;
        local Container = Groupbox.Container;

        local TextLabel = Library:CreateLabel({
            Size = UDim2.new(1, -8, 0, 16);
            TextSize = 13;
            Text = Text;
            TextWrapped = DoesWrap or false;
            TextXAlignment = Enum.TextXAlignment.Left;
            Parent = Container;
        });

        Label.TextLabel = TextLabel;
        Label.Container = Container;

        function Label:SetText(NewText)
            TextLabel.Text = NewText;
            Groupbox:Resize();
        end

        Groupbox:AddBlank(4);
        Groupbox:Resize();
        return Label;
    end;

    function Funcs:AddButton(...)
        local Button = {};
        local Props = select(1, ...)
        if type(Props) == 'table' then
            Button.Text = Props.Text
            Button.Func = Props.Func
            Button.Tooltip = Props.Tooltip
        else
            Button.Text = select(1, ...)
            Button.Func = select(2, ...)
        end

        local Container = self.Container;

        local Outer = Library:Create('Frame', {
            BackgroundColor3 = Library.PanelAlt;
            Size = UDim2.new(1, 0, 0, 32);
            Parent = Container;
            Children = {
                Library:ApplyCorner(UDim.new(0, 6)),
                Library:ApplyStroke(Library.BorderSoft)
            }
        });

        local Label = Library:CreateLabel({
            Size = UDim2.new(1, 0, 1, 0);
            TextSize = 13;
            Text = Button.Text;
            TextColor3 = Library.FontColor;
            TextXAlignment = Enum.TextXAlignment.Center;
            Parent = Outer;
        });

        Outer.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                Library:SafeCallback(Button.Func);
            end
        end)

        self:AddBlank(6);
        self:Resize();
        return Button;
    end;

    function Funcs:AddDivider()
        Library:Create('Frame', {
            BackgroundColor3 = Library.BorderSoft;
            BorderSizePixel = 0;
            Size = UDim2.new(1, 0, 0, 1);
            Parent = self.Container;
        });
        self:AddBlank(6);
        self:Resize();
    end

    function Funcs:AddInput(Idx, Info)
        assert(Info.Text, 'AddInput: Missing `Text` string.')
        local Textbox = {
            Value = Info.Default or '';
            Numeric = Info.Numeric or false;
            Type = 'Input';
            Callback = Info.Callback or function(Value) end;
        };

        local Container = self.Container;

        Library:CreateLabel({
            Size = UDim2.new(1, 0, 0, 16);
            TextSize = 12;
            Text = Info.Text;
            TextColor3 = Library.FontColor;
            Parent = Container;
        });

        self:AddBlank(2);

        local TextBoxOuter = Library:Create('Frame', {
            BackgroundColor3 = Library.PanelAlt;
            Size = UDim2.new(1, 0, 0, 30);
            Parent = Container;
            Children = {
                Library:ApplyCorner(UDim.new(0, 6)),
                Library:ApplyStroke(Library.BorderSoft)
            }
        });

        local Box = Library:Create('TextBox', {
            BackgroundTransparency = 1;
            Position = UDim2.new(0, 10, 0, 0);
            Size = UDim2.new(1, -20, 1, 0);
            Font = Library.Font;
            PlaceholderColor3 = Color3.fromRGB(110, 110, 120);
            PlaceholderText = Info.Placeholder or '';
            Text = Info.Default or '';
            TextColor3 = Library.FontColor;
            TextSize = 13;
            TextXAlignment = Enum.TextXAlignment.Left;
            Parent = TextBoxOuter;
        });

        Box.FocusLost:Connect(function(enter)
            Textbox.Value = Box.Text;
            Library:SafeCallback(Textbox.Callback, Box.Text);
            Library:AttemptSave();
        end)

        Options[Idx] = Textbox;
        self:AddBlank(6);
        self:Resize();
        return Textbox;
    end;

    function Funcs:AddToggle(Idx, Info)
        assert(Info.Text, 'AddToggle: Missing `Text` string.')
        local Toggle = {
            Value = Info.Default or false;
            Type = 'Toggle';
            Callback = Info.Callback or function(Value) end;
            Addons = {},
        };

        local Container = self.Container;

        local Row = Library:Create('Frame', {
            BackgroundTransparency = 1;
            Size = UDim2.new(1, 0, 0, 28);
            Parent = Container;
        });

        Library:CreateLabel({
            Size = UDim2.new(1, -50, 1, 0);
            TextSize = 13;
            Text = Info.Text;
            TextColor3 = Library.FontColor;
            TextXAlignment = Enum.TextXAlignment.Left;
            Parent = Row;
        });

        local Track = Library:Create('TextButton', {
            Size = UDim2.fromOffset(38, 20);
            Position = UDim2.new(1, 0, 0.5, 0);
            AnchorPoint = Vector2.new(1, 0.5);
            BackgroundColor3 = Toggle.Value and Library.AccentColor or Library.PanelAlt;
            AutoButtonColor = false;
            Text = '';
            Parent = Row;
            Children = {
                Library:ApplyCorner(UDim.new(1, 0)),
                Library:ApplyStroke(Library.BorderSoft)
            }
        });

        local Knob = Library:Create('Frame', {
            Size = UDim2.fromOffset(14, 14);
            Position = Toggle.Value and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0);
            AnchorPoint = Vector2.new(Toggle.Value and 1 or 0, 0.5);
            BackgroundColor3 = Color3.fromRGB(255, 255, 255);
            BorderSizePixel = 0;
            Parent = Track;
            Children = {
                Library:ApplyCorner(UDim.new(1, 0))
            }
        });

        function Toggle:SetValue(Bool)
            Toggle.Value = Bool;
            TweenService:Create(Track, TweenInfo.new(0.12), { BackgroundColor3 = Bool and Library.AccentColor or Library.PanelAlt }):Play();
            TweenService:Create(Knob, TweenInfo.new(0.12), {
                Position = Bool and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0);
                AnchorPoint = Vector2.new(Bool and 1 or 0, 0.5);
            }):Play();
            Library:SafeCallback(Toggle.Callback, Bool);
            Library:UpdateDependencyBoxes();
        end

        Track.Activated:Connect(function()
            Toggle:SetValue(not Toggle.Value);
            Library:AttemptSave();
        end);

        Toggle.TextLabel = Row;
        Toggle.Container = Container;
        setmetatable(Toggle, BaseAddons);

        Toggles[Idx] = Toggle;
        self:AddBlank(4);
        self:Resize();
        return Toggle;
    end;

    function Funcs:AddSlider(Idx, Info)
        assert(Info.Default, 'AddSlider: Missing default value.');
        assert(Info.Text, 'AddSlider: Missing text.');
        assert(Info.Min, 'AddSlider: Missing min.');
        assert(Info.Max, 'AddSlider: Missing max.');

        local Slider = {
            Value = Info.Default;
            Min = Info.Min;
            Max = Info.Max;
            Rounding = Info.Rounding or 0;
            Type = 'Slider';
            Callback = Info.Callback or function(Value) end;
        };

        local Container = self.Container;

        local TopRow = Library:Create('Frame', {
            BackgroundTransparency = 1;
            Size = UDim2.new(1, 0, 0, 16);
            Parent = Container;
        });

        Library:CreateLabel({
            Size = UDim2.new(0.7, 0, 1, 0);
            TextSize = 12;
            Text = Info.Text;
            TextColor3 = Library.FontColor;
            TextXAlignment = Enum.TextXAlignment.Left;
            Parent = TopRow;
        });

        local ValLabel = Library:CreateLabel({
            Size = UDim2.new(0.3, 0, 1, 0);
            TextSize = 12;
            Text = tostring(Info.Default) .. (Info.Suffix or '');
            TextColor3 = Color3.fromRGB(170, 170, 178);
            TextXAlignment = Enum.TextXAlignment.Right;
            Parent = TopRow;
        });

        self:AddBlank(2);

        local SliderOuter = Library:Create('Frame', {
            BackgroundColor3 = Library.PanelAlt;
            Size = UDim2.new(1, 0, 0, 8);
            Parent = Container;
            Children = {
                Library:ApplyCorner(UDim.new(1, 0)),
                Library:ApplyStroke(Library.BorderSoft)
            }
        });

        local Fill = Library:Create('Frame', {
            BackgroundColor3 = Library.AccentColor;
            Size = UDim2.new((Info.Default - Info.Min) / (Info.Max - Info.Min), 0, 1, 0);
            BorderSizePixel = 0;
            Parent = SliderOuter;
            Children = {
                Library:ApplyCorner(UDim.new(1, 0))
            }
        });

        function Slider:SetValue(Val)
            Val = math.clamp(Val, Slider.Min, Slider.Max);
            if Slider.Rounding == 0 then
                Val = math.floor(Val);
            else
                Val = tonumber(string.format('%.' .. Slider.Rounding .. 'f', Val));
            end

            Slider.Value = Val;
            ValLabel.Text = tostring(Val) .. (Info.Suffix or '');
            Fill.Size = UDim2.new((Val - Slider.Min) / (Slider.Max - Slider.Min), 0, 1, 0);
            Library:SafeCallback(Slider.Callback, Val);
        end

        SliderOuter.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
                while InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) or InputService:IsMouseButtonPressed(Enum.UserInputType.Touch) do
                    local pos = math.clamp((Mouse.X - SliderOuter.AbsolutePosition.X) / SliderOuter.AbsoluteSize.X, 0, 1);
                    Slider:SetValue(Slider.Min + (Slider.Max - Slider.Min) * pos);
                    RenderStepped:Wait();
                end
                Library:AttemptSave();
            end
        end)

        Options[Idx] = Slider;
        self:AddBlank(6);
        self:Resize();
        return Slider;
    end;

    function Funcs:AddDropdown(Idx, Info)
        assert(Info.Values, 'AddDropdown: Missing values.');
        local Dropdown = {
            Values = Info.Values;
            Value = Info.Default;
            Type = 'Dropdown';
            Callback = Info.Callback or function(Val) end;
        };

        local Container = self.Container;
        Library:CreateLabel({
            Size = UDim2.new(1, 0, 0, 16);
            TextSize = 12;
            Text = Info.Text or '';
            TextColor3 = Library.FontColor;
            Parent = Container;
        });

        self:AddBlank(2);

        local Outer = Library:Create('Frame', {
            BackgroundColor3 = Library.PanelAlt;
            Size = UDim2.new(1, 0, 0, 30);
            Parent = Container;
            Children = {
                Library:ApplyCorner(UDim.new(0, 6)),
                Library:ApplyStroke(Library.BorderSoft)
            }
        });

        local ValLabel = Library:CreateLabel({
            Size = UDim2.new(1, -12, 1, 0);
            Position = UDim2.fromOffset(8, 0);
            TextSize = 13;
            Text = tostring(Info.Default or 'Select...'),
            TextColor3 = Library.FontColor;
            TextXAlignment = Enum.TextXAlignment.Left;
            Parent = Outer;
        });

        function Dropdown:SetValue(Val)
            Dropdown.Value = Val;
            ValLabel.Text = tostring(Val);
            Library:SafeCallback(Dropdown.Callback, Val);
        end

        Options[Idx] = Dropdown;
        self:AddBlank(6);
        self:Resize();
        return Dropdown;
    end;

    BaseGroupbox.__index = Funcs;
end;

function Library:CreateWindow(Config)
    if type(Config) == 'string' then Config = { Title = Config } end
    Config.Title = Config.Title or 'CloverHub';
    Config.Size = Config.Size or UDim2.fromOffset(620, 520);

    local Window = { Tabs = {}; };

    local MainWindow = Library:Create('Frame', {
        Name = 'CloverHubWindow';
        Parent = ScreenGui;
        Size = Config.Size;
        Position = UDim2.new(0.5, -Config.Size.X.Offset / 2, 0.5, -Config.Size.Y.Offset / 2);
        BackgroundColor3 = Library.BackgroundColor;
        BorderSizePixel = 0;
        Visible = false;
        Children = {
            Library:ApplyCorner(UDim.new(0, 10)),
            Library:ApplyStroke(Library.OutlineColor, 1)
        }
    });

    Library:MakeDraggable(MainWindow, 50);

    local Sidebar = Library:Create('Frame', {
        Parent = MainWindow;
        Size = UDim2.new(0, 205, 1, -24);
        BackgroundColor3 = Library.SidebarColor;
        BorderSizePixel = 0;
        Children = {
            Library:ApplyCorner(UDim.new(0, 10))
        }
    });

    Library:Create('Frame', {
        Parent = Sidebar;
        Size = UDim2.new(0, 10, 1, 0);
        Position = UDim2.new(1, -10, 0, 0);
        BackgroundColor3 = Library.SidebarColor;
        BorderSizePixel = 0;
    });

    Library:Create('Frame', {
        Parent = Sidebar;
        Size = UDim2.new(0, 1, 1, 0);
        Position = UDim2.new(1, -1, 0, 0);
        BackgroundColor3 = Library.OutlineColor;
        BorderSizePixel = 0;
    });

    Library:Create('TextLabel', {
        Parent = Sidebar;
        Size = UDim2.new(1, 0, 0, 48);
        BackgroundTransparency = 1;
        Font = Library.FontBold;
        Text = Config.Title;
        TextColor3 = Library.GreenColor;
        TextSize = 18;
        TextXAlignment = Enum.TextXAlignment.Center;
    });

    local NavList = Library:Create('ScrollingFrame', {
        Parent = Sidebar;
        Position = UDim2.new(0, 8, 0, 52);
        Size = UDim2.new(1, -16, 1, -60);
        BackgroundTransparency = 1;
        CanvasSize = UDim2.new(0, 0, 0, 0);
        ScrollBarThickness = 0;
    });

    Library:Create('UIListLayout', {
        Parent = NavList;
        SortOrder = Enum.SortOrder.LayoutOrder;
        Padding = UDim.new(0, 2);
    });

    local Topbar = Library:Create('Frame', {
        Parent = MainWindow;
        Position = UDim2.new(0, 205, 0, 0);
        Size = UDim2.new(1, -205, 0, 50);
        BackgroundTransparency = 1;
    });

    local SearchBox = Library:Create('Frame', {
        Parent = Topbar;
        Size = UDim2.new(1, -80, 0, 30);
        Position = UDim2.new(0, 12, 0.5, 0);
        AnchorPoint = Vector2.new(0, 0.5);
        BackgroundColor3 = Library.MainColor;
        Children = {
            Library:ApplyCorner(UDim.new(0, 6)),
            Library:ApplyStroke(Library.OutlineColor)
        }
    });

    Library:Create('TextBox', {
        Parent = SearchBox;
        Position = UDim2.new(0, 12, 0, 0);
        Size = UDim2.new(1, -24, 1, 0);
        BackgroundTransparency = 1;
        Font = Library.Font;
        PlaceholderText = 'Search...';
        PlaceholderColor3 = Color3.fromRGB(110, 110, 120);
        Text = '';
        TextColor3 = Library.FontColor;
        TextSize = 13;
        TextXAlignment = Enum.TextXAlignment.Left;
    });

    local BottomBar = Library:Create('Frame', {
        Parent = MainWindow;
        Position = UDim2.new(0, 0, 1, -24);
        Size = UDim2.new(1, 0, 0, 24);
        BackgroundColor3 = Library.SidebarColor;
        BorderSizePixel = 0;
        Children = {
            Library:ApplyCorner(UDim.new(0, 10))
        }
    });

    Library:Create('Frame', {
        Parent = BottomBar;
        Size = UDim2.new(1, 0, 0, 12);
        BackgroundColor3 = Library.SidebarColor;
        BorderSizePixel = 0;
    });

    Library:Create('Frame', {
        Parent = BottomBar;
        Size = UDim2.new(1, 0, 0, 1);
        BackgroundColor3 = Library.OutlineColor;
        BorderSizePixel = 0;
    });

    Library:Create('TextLabel', {
        Parent = BottomBar;
        Size = UDim2.fromScale(1, 1);
        BackgroundTransparency = 1;
        Font = Library.Font;
        Text = 'v1.0   ·   CloverHub UI';
        TextColor3 = Color3.fromRGB(110, 110, 120);
        TextSize = 11;
    });

    local ContentArea = Library:Create('Frame', {
        Parent = MainWindow;
        Position = UDim2.new(0, 205, 0, 50);
        Size = UDim2.new(1, -205, 1, -74);
        BackgroundTransparency = 1;
    });
    Library:Create('UIPadding', { Parent = ContentArea, PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 4), PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) });

    function Window:AddTab(Name)
        local Tab = { Groupboxes = {}; };

        local NavBtn = Library:Create('TextButton', {
            Parent = NavList;
            Size = UDim2.new(1, 0, 0, 34);
            BackgroundColor3 = Library.SidebarColor;
            BackgroundTransparency = 1;
            AutoButtonColor = false;
            Text = '';
            Children = {
                Library:ApplyCorner(UDim.new(0, 6))
            }
        });

        local AccentBar = Library:Create('Frame', {
            Parent = NavBtn;
            Size = UDim2.new(0, 3, 1, -8);
            Position = UDim2.new(0, 0, 0.5, 0);
            AnchorPoint = Vector2.new(0, 0.5);
            BackgroundColor3 = Library.AccentColor;
            BackgroundTransparency = 1;
            BorderSizePixel = 0;
            Children = {
                Library:ApplyCorner(UDim.new(0, 2))
            }
        });

        local NavLabel = Library:Create('TextLabel', {
            Parent = NavBtn;
            Position = UDim2.new(0, 16, 0, 0);
            Size = UDim2.new(1, -20, 1, 0);
            BackgroundTransparency = 1;
            Font = Library.FontMed;
            Text = Name;
            TextColor3 = Color3.fromRGB(170, 170, 178);
            TextSize = 13;
            TextXAlignment = Enum.TextXAlignment.Left;
        });

        local TabFrame = Library:Create('Frame', {
            Parent = ContentArea;
            Size = UDim2.fromScale(1, 1);
            BackgroundTransparency = 1;
            Visible = false;
        });

        local LeftSide = Library:Create('ScrollingFrame', {
            Parent = TabFrame;
            Size = UDim2.new(0.5, -4, 1, 0);
            BackgroundTransparency = 1;
            BorderSizePixel = 0;
            CanvasSize = UDim2.new(0, 0, 0, 0);
            ScrollBarThickness = 0;
        });
        Library:Create('UIListLayout', { Parent = LeftSide, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center });

        local RightSide = Library:Create('ScrollingFrame', {
            Parent = TabFrame;
            Position = UDim2.new(0.5, 4, 0, 0);
            Size = UDim2.new(0.5, -4, 1, 0);
            BackgroundTransparency = 1;
            BorderSizePixel = 0;
            CanvasSize = UDim2.new(0, 0, 0, 0);
            ScrollBarThickness = 0;
        });
        Library:Create('UIListLayout', { Parent = RightSide, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center });

        for _, side in ipairs({ LeftSide, RightSide }) do
            side.UIListLayout:GetPropertyChangedSignal('AbsoluteContentSize'):Connect(function()
                side.CanvasSize = UDim2.fromOffset(0, side.UIListLayout.AbsoluteContentSize.Y);
            end);
        end

        function Tab:Show()
            for _, t in next, Window.Tabs do
                t:Hide();
            end
            TabFrame.Visible = true;
            TweenService:Create(NavBtn, TweenInfo.new(0.12), { BackgroundTransparency = 0.85, BackgroundColor3 = Library.AccentColor }):Play();
            TweenService:Create(AccentBar, TweenInfo.new(0.12), { BackgroundTransparency = 0 }):Play();
            TweenService:Create(NavLabel, TweenInfo.new(0.12), { TextColor3 = Library.FontColor }):Play();
        end

        function Tab:Hide()
            TabFrame.Visible = false;
            TweenService:Create(NavBtn, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play();
            TweenService:Create(AccentBar, TweenInfo.new(0.12), { BackgroundTransparency = 1 }):Play();
            TweenService:Create(NavLabel, TweenInfo.new(0.12), { TextColor3 = Color3.fromRGB(170, 170, 178) }):Play();
        end

        NavBtn.Activated:Connect(function()
            Tab:Show();
        end);

        function Tab:AddGroupbox(Info)
            local Groupbox = {};
            local Side = Info.Side == 1 and LeftSide or RightSide;

            local BoxOuter = Library:Create('Frame', {
                Parent = Side;
                BackgroundColor3 = Library.MainColor;
                Size = UDim2.new(1, 0, 0, 200);
                Children = {
                    Library:ApplyCorner(UDim.new(0, 8)),
                    Library:ApplyStroke(Library.OutlineColor)
                }
            });

            local Header = Library:Create('TextButton', {
                Parent = BoxOuter;
                Size = UDim2.new(1, 0, 0, 34);
                BackgroundTransparency = 1;
                AutoButtonColor = false;
                Text = '';
            });

            Library:Create('TextLabel', {
                Parent = Header;
                Position = UDim2.new(0, 12, 0, 0);
                Size = UDim2.new(1, -24, 1, 0);
                BackgroundTransparency = 1;
                Font = Library.FontBold;
                Text = Info.Name;
                TextColor3 = Library.FontColor;
                TextSize = 13;
                TextXAlignment = Enum.TextXAlignment.Left;
            });

            Library:Create('Frame', {
                Parent = BoxOuter;
                Size = UDim2.new(1, 0, 0, 1);
                Position = UDim2.new(0, 0, 0, 34);
                BackgroundColor3 = Library.OutlineColor;
                BorderSizePixel = 0;
            });

            local Container = Library:Create('Frame', {
                Parent = BoxOuter;
                Position = UDim2.new(0, 0, 0, 35);
                Size = UDim2.new(1, 0, 1, -35);
                BackgroundTransparency = 1;
            });
            Library:Create('UIPadding', { Parent = Container, PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 8), PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) });

            Library:Create('UIListLayout', {
                Parent = Container;
                SortOrder = Enum.SortOrder.LayoutOrder;
                FillDirection = Enum.FillDirection.Vertical;
            });

            function Groupbox:Resize()
                local size = 35;
                for _, child in ipairs(Container:GetChildren()) do
                    if not child:IsA('UIListLayout') and not child:IsA('UIPadding') then
                        size = size + child.AbsoluteSize.Y + 6;
                    end
                end
                BoxOuter.Size = UDim2.new(1, 0, 0, math.max(size, 50));
            end

            Groupbox.Container = Container;
            setmetatable(Groupbox, BaseGroupbox);

            Window.Tabs[Name] = Window.Tabs[Name] or Tab;
            return Groupbox;
        end

        function Tab:AddLeftGroupbox(Name) return Tab:AddGroupbox({ Side = 1, Name = Name }) end
        function Tab:AddRightGroupbox(Name) return Tab:AddGroupbox({ Side = 2, Name = Name }) end

        function Tab:AddTabbox(Info)
            local Tabbox = { Tabs = {}; };
            local Side = Info.Side == 1 and LeftSide or RightSide;

            local BoxOuter = Library:Create('Frame', {
                Parent = Side;
                BackgroundColor3 = Library.MainColor;
                Size = UDim2.new(1, 0, 0, 200);
                Children = {
                    Library:ApplyCorner(UDim.new(0, 8)),
                    Library:ApplyStroke(Library.OutlineColor)
                }
            });

            local TabboxButtons = Library:Create('Frame', {
                BackgroundTransparency = 1;
                Size = UDim2.new(1, 0, 0, 34);
                Parent = BoxOuter;
            });

            Library:Create('UIListLayout', {
                FillDirection = Enum.FillDirection.Horizontal;
                SortOrder = Enum.SortOrder.LayoutOrder;
                Parent = TabboxButtons;
            });

            Library:Create('Frame', {
                Parent = BoxOuter;
                Size = UDim2.new(1, 0, 0, 1);
                Position = UDim2.new(0, 0, 0, 34);
                BackgroundColor3 = Library.OutlineColor;
                BorderSizePixel = 0;
            });

            function Tabbox:AddTab(SubTabName)
                local SubTab = {};
                local Button = Library:Create('TextButton', {
                    BackgroundColor3 = Library.PanelAlt;
                    Size = UDim2.new(0.5, 0, 1, 0);
                    Text = '';
                    AutoButtonColor = false;
                    Parent = TabboxButtons;
                });

                local ButtonLabel = Library:CreateLabel({
                    Size = UDim2.new(1, 0, 1, 0);
                    Text = SubTabName;
                    TextColor3 = Color3.fromRGB(170, 170, 178);
                    TextXAlignment = Enum.TextXAlignment.Center;
                    Parent = Button;
                });

                local Container = Library:Create('Frame', {
                    BackgroundTransparency = 1;
                    Position = UDim2.new(0, 0, 0, 35);
                    Size = UDim2.new(1, 0, 1, -35);
                    Visible = false;
                    Parent = BoxOuter;
                });
                Library:Create('UIPadding', { Parent = Container, PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 8), PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) });
                Library:Create('UIListLayout', { Parent = Container, SortOrder = Enum.SortOrder.LayoutOrder, FillDirection = Enum.FillDirection.Vertical });

                function SubTab:Show()
                    for _, t in next, Tabbox.Tabs do t:Hide(); end;
                    Container.Visible = true;
                    Button.BackgroundColor3 = Library.AccentColorDark;
                    ButtonLabel.TextColor3 = Library.FontColor;
                    SubTab:Resize();
                end;

                function SubTab:Hide()
                    Container.Visible = false;
                    Button.BackgroundColor3 = Library.PanelAlt;
                    ButtonLabel.TextColor3 = Color3.fromRGB(170, 170, 178);
                end;

                function SubTab:Resize()
                    local TabCount = 0;
                    for _, _ in next, Tabbox.Tabs do TabCount = TabCount + 1; end;
                    for _, Btn in next, TabboxButtons:GetChildren() do
                        if not Btn:IsA('UIListLayout') then Btn.Size = UDim2.new(1 / TabCount, 0, 1, 0); end;
                    end;
                    if not Container.Visible then return end;
                    local size = 35;
                    for _, child in ipairs(Container:GetChildren()) do
                        if not child:IsA('UIListLayout') and not child:IsA('UIPadding') then
                            size = size + child.AbsoluteSize.Y + 6;
                        end
                    end
                    BoxOuter.Size = UDim2.new(1, 0, 0, math.max(size, 50));
                end;

                Button.Activated:Connect(function() SubTab:Show() end);
                SubTab.Container = Container;
                Tabbox.Tabs[SubTabName] = SubTab;
                setmetatable(SubTab, BaseGroupbox);

                if #TabboxButtons:GetChildren() == 2 then SubTab:Show() end;
                return SubTab;
            end;

            return Tabbox;
        end;

        function Tab:AddLeftTabbox(Name) return Tab:AddTabbox({ Name = Name, Side = 1 }) end
        function Tab:AddRightTabbox(Name) return Tab:AddTabbox({ Name = Name, Side = 2 }) end

        if #NavList:GetChildren() == 2 then
            Tab:Show();
        end

        Window.Tabs[Name] = Tab;
        return Tab;
    end;

    local Toggled = false;
    function Library:Toggle()
        Toggled = not Toggled;
        MainWindow.Visible = Toggled;
    end

    InputService.InputBegan:Connect(function(Input, Processed)
        if Input.KeyCode == Enum.KeyCode.RightControl or (Input.KeyCode == Enum.KeyCode.RightShift and not Processed) then
            Library:Toggle();
        end
    end)

    if Config.AutoShow then Library:Toggle() end
    return Window;
end;

-- Notifications System
Library.NotificationArea = Library:Create('Frame', {
    BackgroundTransparency = 1;
    Position = UDim2.new(1, -20, 1, -20);
    AnchorPoint = Vector2.new(1, 1);
    Size = UDim2.new(0, 300, 0, 400);
    ZIndex = 100;
    Parent = ScreenGui;
});

Library:Create('UIListLayout', {
    Padding = UDim.new(0, 8);
    FillDirection = Enum.FillDirection.Vertical;
    VerticalAlignment = Enum.VerticalAlignment.Bottom;
    SortOrder = Enum.SortOrder.LayoutOrder;
    Parent = Library.NotificationArea;
});

function Library:Notify(Text, Time)
    local YSize = Library:GetTextBounds(Text, Library.Font, 13) + 16;
    local NotifyOuter = Library:Create('Frame', {
        BackgroundColor3 = Library.MainColor;
        Size = UDim2.new(1, 0, 0, YSize);
        BackgroundTransparency = 1;
        ZIndex = 101;
        Parent = Library.NotificationArea;
        Children = {
            Library:ApplyCorner(UDim.new(0, 6)),
            Library:ApplyStroke(Library.OutlineColor)
        }
    });

    local NotifyLabel = Library:CreateLabel({
        Position = UDim2.new(0, 12, 0, 0);
        Size = UDim2.new(1, -24, 1, 0);
        Text = Text;
        TextTransparency = 1;
        TextXAlignment = Enum.TextXAlignment.Left;
        ZIndex = 103;
        Parent = NotifyOuter;
    });

    local Accent = Library:Create('Frame', {
        BackgroundColor3 = Library.AccentColor;
        BorderSizePixel = 0;
        Position = UDim2.new(0, 0, 0, 0);
        Size = UDim2.new(0, 3, 1, 0);
        BackgroundTransparency = 1;
        ZIndex = 104;
        Parent = NotifyOuter;
        Children = {
            Library:ApplyCorner(UDim.new(0, 2))
        }
    });

    TweenService:Create(NotifyOuter, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
    TweenService:Create(NotifyLabel, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
    TweenService:Create(Accent, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()

    task.spawn(function()
        task.wait(Time or 5);
        TweenService:Create(NotifyOuter, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(NotifyLabel, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
        TweenService:Create(Accent, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
        task.wait(0.2);
        NotifyOuter:Destroy();
    end);
end;

-- Watermark System
local WatermarkOuter = Library:Create('Frame', {
    BackgroundColor3 = Library.MainColor;
    Position = UDim2.new(0, 20, 0, 20);
    Size = UDim2.new(0, 200, 0, 30);
    Visible = false;
    ZIndex = 200;
    Parent = ScreenGui;
    Children = {
        Library:ApplyCorner(UDim.new(0, 6)),
        Library:ApplyStroke(Library.AccentColor, 1)
    }
});

local WatermarkLabel = Library:CreateLabel({
    Size = UDim2.new(1, 0, 1, 0);
    Text = 'CloverHub';
    TextSize = 13;
    ZIndex = 201;
    Parent = WatermarkOuter;
});

Library.Watermark = WatermarkOuter;
Library.WatermarkText = WatermarkLabel;
Library:MakeDraggable(Library.Watermark, 30);

function Library:SetWatermarkVisibility(Bool)
    Library.Watermark.Visible = Bool;
end;

function Library:SetWatermark(Text)
    local X = Library:GetTextBounds(Text, Library.Font, 13);
    Library.Watermark.Size = UDim2.new(0, X + 24, 0, 30);
    Library:SetWatermarkVisibility(true)
    Library.WatermarkText.Text = Text;
end;

getgenv().Library = Library;
return Library;
